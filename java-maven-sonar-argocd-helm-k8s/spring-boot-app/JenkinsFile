pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t springboot-app:${BUILD_NUMBER} .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                docker stop springboot-app || true
                docker rm springboot-app || true

                docker run -d \
                --name springboot-app \
                -p 8081:8080 \
                springboot-app:${BUILD_NUMBER}
                '''
            }
        }
    }
}
